+    assert 0.01 < st["processing_s"] < 0.2 and sahi["processing_s"] > st["processing_s"]   # tens of ms, not s or us
+    assert 0 < st["decoding_s"] < 0.01 and all(0 < v < 0.1 for v in st["encoding_s"].values())
