# --- data and weights: too large for git, and reproducible from the scripts ---
code/data/
code/runs/
code/yolov8n.pt
code/models/*.pt

# --- rendered swath imagery: large JPG/PNG binaries, regenerable from wp15_build_swaths.py ---
code/results/wp15_swaths/
code/results/wp15_examples/

# --- environments ---
code/.venv/
code/.venv312/

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- kaggle upload staging: local scaffolding only, not part of the repo ---
kaggle_upload/

# --- demo live-run scratch outputs (never the authoritative results) ---
demo/_live/

# --- results noise: run logs, console dumps, and smoke-test scratch (not real results) ---
code/results/*.log
code/results/*stdout*.txt
code/results/*SMOKETEST*
code/results/*1epoch*
